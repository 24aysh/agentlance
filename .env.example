# Copy to .env (ignored). Load explicitly with:
# uv run --env-file .env python -m apps.reference_agent.main --mode monad
# Keeping forecast.enabled=false in the JSON config makes no Jev calls.

# Jev uses TypeSafe's official key name. Never put the key in JSON, an Agent Card or git.
TYPESAFE_API_KEY=

# Only execution.executor.kind=AGENTS uses this; never passed into Docker containers.
OPENAI_API_KEY=

# Complete reference-agent JSON configuration; includes qualified deployment facts.
# Copy the economics block documented in docs/layer-5.md, then supply actual prices/limits.
AGENTLANCE_CONFIG=.scratch/agent/config.json

# These names must match executionKeystore.passwordEnv and ownerKeystore.passwordEnv.
# Use encrypted keystore paths in the JSON configuration, never plaintext private keys.
AGENTLANCE_KEYSTORE_PASSWORD=
AGENTLANCE_OWNER_KEYSTORE_PASSWORD=

# Optional Layer 3 testnet driver actor/keystore configuration (not used by the agent).
# AGENTLANCE_L3_ACTORS=.scratch/testnet/actors.json

# Model, request version, timeout, pricing, FX, budgets and risk settings are explicit
# fields in config.economics. They are hashed and retained with each decision, so
# there are no unrecorded environment overrides for economic policy or chain authority.

# Layer 7 runs in its own process/database. See docs/layer-7.md.
AGENTLANCE_VALIDATOR_CONFIG=.scratch/validator/config.json
AGENTLANCE_VALIDATOR_KEYSTORE_PASSWORD=
AGENTLANCE_RELAYER_KEYSTORE_PASSWORD=
# Optional complete Authorization header for the explicitly configured trusted Kubo RPC.
# Leave config.kuboAuthorizationEnv=null for an isolated localhost node without authentication.
AGENTLANCE_KUBO_AUTHORIZATION=

# Explicit publisher deployment script only; qualified public addresses, never defaults.
# AGENTLANCE_MARKET=
# AGENTLANCE_IDENTITY_REGISTRY=
# AGENTLANCE_REPUTATION_REGISTRY=

# Layer 8 requester/inspection CLI; isolated application database and encrypted EOA.
AGENTLANCE_APP_CONFIG=.scratch/requester/config.json
# Match config.keystore.passwordEnv. Read and export commands never load this key.
AGENTLANCE_REQUESTER_KEYSTORE_PASSWORD=
# Independent local Node example: match its encrypted keystore passwordEnv.
AGENTLANCE_EXTERNAL_KEYSTORE_PASSWORD=
